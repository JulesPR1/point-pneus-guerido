<% content_for :title, "Réglages du site" %>
<div class="admin-head">
  <div>
    <h1>Réglages du site</h1>
    <p>Ces informations alimentent l'en-tête, le pied de page, les sections « Horaires », « Coordonnées » et « Carte », ainsi que les données structurées.</p>
  </div>
</div>

<section class="panel">
  <%= form_with model: [ :admin, @site_setting ], url: admin_site_setting_path, method: :patch, class: "admin-form" do |f| %>
    <%= render "admin/shared/errors", record: @site_setting %>

    <div class="form-grid">
      <div class="field field--half">
        <%= f.label :company_name, "Raison sociale", class: "label" %>
        <%= f.text_field :company_name, class: "input", required: true %>
      </div>
      <div class="field field--half">
        <%= f.label :tagline, "Accroche", class: "label" %>
        <%= f.text_field :tagline, class: "input" %>
      </div>
      <div class="field field--half">
        <%= f.label :phone, "Téléphone", class: "label" %>
        <%= f.text_field :phone, class: "input", required: true %>
      </div>
      <div class="field field--half">
        <%= f.label :email, "E-mail", class: "label" %>
        <%= f.email_field :email, class: "input" %>
      </div>
      <div class="field field--full">
        <%= f.label :address_line, "Adresse", class: "label" %>
        <%= f.text_field :address_line, class: "input" %>
      </div>
      <div class="field field--half">
        <%= f.label :postal_code, "Code postal", class: "label" %>
        <%= f.text_field :postal_code, class: "input" %>
      </div>
      <div class="field field--half">
        <%= f.label :city, "Ville", class: "label" %>
        <%= f.text_field :city, class: "input" %>
      </div>
    </div>

    <div class="field">
      <%= f.label :opening_hours, "Horaires", class: "label" %>
      <%= f.text_area :opening_hours, class: "textarea", rows: 4 %>
      <p class="field-note">Une ligne par créneau, au format <code>Jour|Horaire</code>. Exemple : <code>Lundi – vendredi|8h – 12h / 14h – 18h30</code></p>
    </div>

    <div class="field">
      <%= f.label :legal_notice, "Mentions légales", class: "label" %>
      <%= f.text_area :legal_notice, class: "textarea", rows: 12 %>
      <p class="field-note">
        Ouvertes depuis le pied de page, sur toutes les pages du site. Ligne vide = nouveau
        paragraphe, <code>## </code> = sous-titre, <code>- </code> = puce,
        <code>[libellé](https://…)</code> = lien. Laissez vide pour retirer le lien du pied de page.
      </p>
    </div>

    <div class="form-grid">
      <div class="field field--full">
        <%= f.label :map_embed_url, "URL d'intégration de la carte", class: "label" %>
        <%= f.url_field :map_embed_url, class: "input" %>
        <p class="field-note">Adresse de l'iframe fournie par Google Maps (« Partager » → « Intégrer une carte ») ou OpenStreetMap. La carte apparaît en pied de page et dans les sections « Carte ».</p>
      </div>
      <div class="field field--full">
        <label class="checkbox-row">
          <%= f.check_box :map_autoload %>
          <span>Afficher la carte directement, sans bouton</span>
        </label>
        <p class="field-note">
          Coché, la carte est dans la page. Si l'URL ci-dessus est une carte Google, son iframe dépose
          des cookies dès l'affichage : il faut alors un bandeau de consentement sur le site.
          Décoché, la carte n'est insérée qu'au clic sur « Afficher le plan d'accès », et aucune
          requête ne part tant que le visiteur ne l'a pas demandé. Un export OpenStreetMap ne dépose
          rien : avec lui, la case peut rester cochée sans autre précaution.
        </p>
      </div>
      <div class="field field--full">
        <%= f.label :map_link_url, "Lien d'itinéraire", class: "label" %>
        <%= f.url_field :map_link_url, class: "input" %>
      </div>
    </div>

    <h2 style="margin: var(--space-7) 0 var(--space-4); font-size: var(--step-1)">Identité et référencement</h2>
    <div class="form-grid">
      <div class="field field--half">
        <%= f.label :logo, "Logo", class: "label" %>
        <% if @site_setting.logo.attached? %>
          <div class="attachment-preview"><%= image_tag @site_setting.logo, alt: "", style: "width: 12rem; height: auto" %></div>
        <% end %>
        <%= f.file_field :logo, class: "input", accept: "image/png,image/jpeg,image/webp,image/svg+xml" %>
      </div>
      <div class="field field--half">
        <%= f.label :default_og_image, "Image de partage par défaut", class: "label" %>
        <% if @site_setting.default_og_image.attached? %>
          <div class="attachment-preview"><%= image_tag @site_setting.default_og_image.variant(:og), alt: "" %></div>
        <% end %>
        <%= f.file_field :default_og_image, class: "input", accept: "image/png,image/jpeg,image/webp" %>
      </div>
      <div class="field field--full">
        <%= f.label :default_seo_title, "Suffixe de titre SEO", class: "label" %>
        <%= f.text_field :default_seo_title, class: "input" %>
        <p class="field-note">Ajouté après le titre de chaque page, séparé par un tiret.</p>
      </div>
      <div class="field field--full">
        <%= f.label :default_meta_description, "Meta description par défaut", class: "label" %>
        <%= f.text_area :default_meta_description, class: "textarea", rows: 3 %>
      </div>
    </div>

    <div class="form-footer">
      <%= f.submit "Enregistrer les réglages", class: "btn btn--primary" %>
    </div>
  <% end %>
</section>
