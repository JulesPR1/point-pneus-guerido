<% content_for :title, "Ajouter des images" %>
<div class="admin-head"><div><h1>Ajouter des images</h1></div></div>

<section class="panel">
  <%= form_with model: [ :admin, @media_item ], class: "admin-form" do |f| %>
    <%= render "admin/shared/errors", record: @media_item %>

    <div class="field">
      <%= label_tag "media_item_files", "Fichiers", class: "label" %>
      <%= file_field_tag "media_item[files][]", multiple: true, id: "media_item_files",
                         class: "input", accept: "image/jpeg,image/png,image/webp,image/gif,image/avif", required: true %>
      <p class="field-note">JPEG, PNG, WebP, GIF ou AVIF — 10 Mo maximum par fichier.</p>
    </div>

    <div class="field">
      <%= f.label :alt_text, "Texte alternatif", class: "label" %>
      <%= f.text_field :alt_text, class: "input" %>
      <p class="field-note">Décrit l'image pour les lecteurs d'écran et les moteurs de recherche.</p>
    </div>

    <div class="form-footer">
      <%= f.submit "Téléverser", class: "btn btn--primary" %>
      <%= link_to "Annuler", admin_media_items_path, class: "btn btn--quiet" %>
    </div>
  <% end %>
</section>
