<%= form_with model: [ :admin, page ], class: "admin-form" do |f| %>
  <%= render "admin/shared/errors", record: page %>

  <div class="form-grid">
    <div class="field field--full">
      <%= f.label :title, "Titre de la page", class: "label" %>
      <%= f.text_field :title, class: "input", required: true, autofocus: page.new_record? %>
    </div>

    <div class="field field--half">
      <%= f.label :slug, "Adresse (slug)", class: "label" %>
      <%= f.text_field :slug, class: "input", placeholder: "ex. geometrie-3d" %>
      <p class="field-note">Laissez vide pour la générer depuis le titre. <%= "La page d'accueil reste servie sur /." if page.home? %></p>
    </div>

    <div class="field field--half">
      <%= f.label :nav_label, "Libellé dans le menu", class: "label" %>
      <%= f.text_field :nav_label, class: "input", placeholder: page.title %>
    </div>

    <div class="field field--half">
      <%= f.label :status, "Statut", class: "label" %>
      <%= f.select :status, [ [ "Brouillon", "draft" ], [ "Publiée", "published" ] ], {}, class: "select" %>
    </div>

    <div class="field field--half">
      <%= f.label :position, "Position dans le menu", class: "label" %>
      <%= f.number_field :position, class: "input", min: 0 %>
    </div>

    <div class="field field--half">
      <%= f.label :parent_id, "Page parente (sous-menu)", class: "label" %>
      <%= f.collection_select :parent_id,
            Page.top_level.ordered.where.not(id: page.id).where(home: false), :id, :title,
            { include_blank: "— Aucune (menu principal)" }, class: "select" %>
    </div>
  </div>

  <div class="checkbox-row">
    <%= f.check_box :show_in_nav %>
    <%= f.label :show_in_nav, "Afficher dans le menu" %>
  </div>

  <h2 style="margin: var(--space-7) 0 var(--space-4); font-size: var(--step-1)">Référencement</h2>
  <div class="form-grid">
    <div class="field field--full">
      <%= f.label :seo_title, "Titre SEO", class: "label" %>
      <%= f.text_field :seo_title, class: "input", maxlength: 70, placeholder: page.title %>
      <p class="field-note">70 caractères maximum. Laissez vide pour reprendre le titre de la page.</p>
    </div>

    <div class="field field--full">
      <%= f.label :meta_description, "Meta description", class: "label" %>
      <%= f.text_area :meta_description, class: "textarea", rows: 3, maxlength: 200 %>
      <p class="field-note">160 caractères conseillés, 200 maximum.</p>
    </div>

    <div class="field field--full">
      <%= f.label :og_image, "Image de partage (Open Graph)", class: "label" %>
      <% if page.og_image.attached? %>
        <div class="attachment-preview">
          <%= image_tag page.og_image.variant(:og), alt: "" %>
          <label class="checkbox-row" style="margin: 0">
            <%= f.check_box :remove_og_image, {}, "1", "0" %>
            <span>Supprimer cette image</span>
          </label>
        </div>
      <% end %>
      <%= f.file_field :og_image, class: "input", accept: "image/jpeg,image/png,image/webp" %>
      <p class="field-note">1200 × 630 px recommandé.</p>
    </div>
  </div>

  <div class="form-footer">
    <%= f.submit page.new_record? ? "Créer la page" : "Enregistrer", class: "btn btn--primary" %>
    <%= link_to "Annuler", page.new_record? ? admin_pages_path : admin_page_path(page), class: "btn btn--quiet" %>
    <% unless page.new_record? || page.home? %>
      <span class="spacer"></span>
      <%= button_to "Supprimer la page", admin_page_path(page), method: :delete,
                    class: "btn btn--danger btn--sm",
                    form: { data: { turbo_confirm: "Supprimer « #{page.title} » et toutes ses sections ?" } } %>
    <% end %>
  </div>
<% end %>
