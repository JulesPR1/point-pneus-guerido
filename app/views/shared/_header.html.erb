<div data-controller="drawer">
<div class="topbar">
  <div class="shell topbar__inner">
    <div class="topbar__hours">
      <% site_setting.hours.each do |day, slot| %>
        <span><b><%= day %></b> <%= slot %></span>
      <% end %>
    </div>
    <% if site_setting.phone.present? %>
      <a class="topbar__phone" href="<%= site_setting.phone_link %>">
        <span aria-hidden="true">☎</span>
        <span class="visually-hidden">Téléphone :</span><%= site_setting.phone %>
      </a>
    <% end %>
  </div>
</div>

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="<%= root_path %>" aria-label="<%= site_setting.company_name %> — accueil">
      <% if site_setting.logo.attached? %>
        <%= image_tag site_setting.logo, alt: site_setting.company_name, height: 48, decoding: "async" %>
      <% else %>
        <span class="brand__fallback"><%= site_setting.company_name %></span>
      <% end %>
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      <ul>
        <% nav_pages.each do |page| %>
          <% children = page.children.select { |c| c.published? && c.show_in_nav? } %>
          <li class="<%= "nav__group" if children.any? %>">
            <a class="nav__link" href="<%= page_path(page) %>"
               <%= tag.attributes(:"aria-current" => "page") if active_page?(page) %>>
              <%= page.nav_title %>
              <% if children.any? %><span class="nav__caret" aria-hidden="true"></span><% end %>
            </a>
            <% if children.any? %>
              <div class="nav__panel">
                <% children.each do |child| %>
                  <a href="<%= page_path(child) %>" <%= tag.attributes(:"aria-current" => "page") if active_page?(child) %>><%= child.nav_title %></a>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    </nav>

    <div class="header__actions">
      <%= link_to "Devis gratuit", quote_page_path, class: "btn btn--primary btn--sm" %>
      <button class="burger" type="button" data-action="drawer#open"
              data-drawer-target="toggle" aria-expanded="false" aria-controls="menu-mobile">
        <span></span><span></span><span></span>
        <span class="visually-hidden">Ouvrir le menu</span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="menu-mobile" hidden data-drawer-target="panel">
  <div class="drawer__head">
    <a class="brand" href="<%= root_path %>">
      <% if site_setting.logo.attached? %>
        <%= image_tag site_setting.logo, alt: site_setting.company_name, height: 34, decoding: "async" %>
      <% else %>
        <span class="brand__fallback"><%= site_setting.company_name %></span>
      <% end %>
    </a>
    <button class="drawer__close" type="button" data-action="drawer#close" aria-label="Fermer le menu">✕</button>
  </div>

  <nav class="drawer__nav" aria-label="Navigation mobile">
    <a href="<%= root_path %>" <%= tag.attributes(:"aria-current" => "page") if current_page?(root_path) %>>Accueil</a>
    <% nav_pages.each do |page| %>
      <a href="<%= page_path(page) %>" <%= tag.attributes(:"aria-current" => "page") if active_page?(page) %>><%= page.nav_title %></a>
      <% page.children.select { |c| c.published? && c.show_in_nav? }.each do |child| %>
        <a class="drawer__child" href="<%= page_path(child) %>" <%= tag.attributes(:"aria-current" => "page") if active_page?(child) %>><%= child.nav_title %></a>
      <% end %>
    <% end %>

    <div class="drawer__cta">
      <%= link_to "Demander un devis", quote_page_path, class: "btn btn--primary btn--block" %>
      <% if site_setting.phone.present? %>
        <%= link_to "Appeler le #{site_setting.phone}", site_setting.phone_link, class: "btn btn--on-dark btn--block" %>
      <% end %>
    </div>
  </nav>
</div>
</div>
